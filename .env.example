# FraudLab environment configuration (template — safe to commit).
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be committed.

# Groq API key for live Investigation Agent narratives (Phase 6).
# If absent or invalid, the agent automatically uses the deterministic offline fallback.
GROQ_API_KEY=

# PostgreSQL connection for dataset history persistence.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# The target database is auto-created on startup if it does not exist.
# If unset or unreachable, dataset history is disabled (generation still works).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraudlab
